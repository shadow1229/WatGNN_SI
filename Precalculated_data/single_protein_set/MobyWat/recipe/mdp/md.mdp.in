; Jeszenoi et al. 2015 Bioinformatics, Suppl. S1.2 protocol
define       = -DPOSRES           ; 1000 kJ/mol/nm^2 on all protein heavy atoms
integrator   = md
dt           = 0.002
nsteps       = @NSTEPS@
nstxout-compressed = @NSTXTC@     ; 1 ps -> 1.0001e4 frames for 10 ns
compressed-x-precision = 1000
nstlog       = 5000
nstenergy    = 5000
constraints  = h-bonds
constraint-algorithm = lincs
cutoff-scheme = Verlet
coulombtype  = PME
rcoulomb     = 1.1
rvdw         = 1.1
pbc          = xyz
tcoupl       = v-rescale
tc-grps      = Protein Non-Protein
tau-t        = 0.1 0.1
ref-t        = 300 300
pcoupl       = Parrinello-Rahman
pcoupltype   = isotropic
tau-p        = 0.5
compressibility = 4.5e-5
ref-p        = 1.0
refcoord-scaling = com
gen-vel      = yes
gen-temp     = 300
gen-seed     = @SEED@
